# 松果AI环境变量配置示例
# 复制此文件为 .env 并填入真实的API密钥

# Google Gemini API 配置（主要AI服务）
GEMINI_API_KEY=your-gemini-api-key-here

# Nano Banana API配置（主要API）
NANO_BANANA_API_KEY=your-nano-banana-api-key-here
HUNYUAN3D_API_KEY=your-hunyuan3d-api-key-here

# Notion集成配置（作品同步到Notion数据库）
NOTION_TOKEN=your-notion-integration-token
NOTION_DATABASE_ID=your-notion-database-id

# Flask 配置
FLASK_ENV=production  # 生产环境使用production，开发环境使用development
FLASK_DEBUG=False  # 生产环境必须为False
SECRET_KEY=your-secret-key-here  # 使用: python -c "import secrets; print(secrets.token_hex(32))"

# 数据库配置
# 生产环境推荐使用PostgreSQL（最佳性能，支持JSONB）
DATABASE_URL=postgresql://hltraining_user:your_password@localhost:5432/hltraining_db

# 备选方案：MariaDB/MySQL
# DATABASE_URL=mysql+pymysql://hltraining_user:your_password@localhost:3306/hltraining_db

# 开发环境可以使用SQLite
# DATABASE_URL=sqlite:///instance/artworks.db

# 服务器配置
HOST=0.0.0.0
PORT=8080  # 生产环境端口（Nginx反向代理）
WORKERS=4  # Gunicorn worker数量（CPU核心数 * 2 + 1）

# 文件上传配置
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,mp4,glb,obj

# 会话安全配置（生产环境必须启用）
SESSION_COOKIE_SECURE=True  # 仅HTTPS传输cookie
SESSION_COOKIE_HTTPONLY=True  # 防止JavaScript访问cookie
SESSION_COOKIE_SAMESITE=Lax  # CSRF保护
# PERMANENT_SESSION_LIFETIME=3600  # 会话时长（秒）

# 日志配置
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/hltraining.log

# 邮件服务配置 (用于家长验证)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=松果AI <your-gmail-address@gmail.com>

# API密钥获取方法：
# 1. 🍌 Nano Banana API 密钥：https://nanobanana.ai/
#    - 注册账户并创建API密钥
#    - 这是主要的AI图像处理服务，支持用户自定义描述
# 2. 🔑 Gemini API（备用）：https://aistudio.google.com/app/apikey
# 3. 🎯 Hunyuan3D API（备用）：https://hunyuan3d.tencent.com/
# 4. � Gmail SMTP 配置：
#    - 启用Gmail两步验证
#    - 生成应用密码：https://myaccount.google.com/apppasswords
#    - 使用应用密码，不是Gmail登录密码
# 5. �🔐 生成安全的SECRET_KEY：
#    python -c "import secrets; print(secrets.token_hex(32))"

# ⚠️  重要提醒：
# - 复制此文件为 .env 并填入真实密钥
# - 不要将真实API密钥或邮箱密码提交到Git仓库
# - Gemini API密钥是免费的，但有使用限制
# - 没有API密钥时系统会自动使用OpenCV备用方案
# - 没有邮件配置时会使用模拟模式